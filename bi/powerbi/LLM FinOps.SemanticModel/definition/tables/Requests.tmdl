table Requests
	lineageTag: 12e66924-1cbd-48bb-83e5-f3fbf9296bcb

	measure Requests = COUNTROWS('Requests')
		formatString: #,0
		lineageTag: 1f094bf9-75ce-4378-b93a-5a780a1ea429

	measure 'Spend USD' = SUM('Requests'[Policy Spend])
		formatString: $#,0.00
		lineageTag: 3d02e399-5fe0-44dd-adde-1c34f06ed8d7

	measure 'Cost per 1k' = 1000 * DIVIDE([Spend USD], COUNT('Requests'[Policy Spend]))
		formatString: $#,0.00
		lineageTag: 361b01b2-dc5e-4ba6-bb0b-f89f5c051412

	measure 'p95 latency' =
			VAR Eligible = FILTER('Requests', 'Requests'[Status] = "ok" && NOT ISBLANK('Requests'[Latency ms]))
			RETURN IF(COUNTROWS(Eligible) > 0, PERCENTILEX.INC(Eligible, 'Requests'[Latency ms], 0.95))
		formatString: #,0 "ms"
		lineageTag: 837af038-4590-4517-9969-8f0cc383d22f

	measure 'MoM savings' =
			VAR PriorSpend = CALCULATE([Spend USD], DATEADD('Calendar'[Date], -1, MONTH))
			RETURN DIVIDE(PriorSpend - [Spend USD], PriorSpend)
		formatString: 0.0%
		lineageTag: 550b6e4d-7561-4896-b607-2542cf15da6d

	measure 'Hybrid savings' =
			VAR AllCloud = CALCULATE([Cost per 1k], REMOVEFILTERS('Models'), REMOVEFILTERS('Requests'[Model]), 'Requests'[Policy] = "all_cloud")
			VAR Hybrid = CALCULATE([Cost per 1k], REMOVEFILTERS('Models'), REMOVEFILTERS('Requests'[Model]), 'Requests'[Policy] = "hybrid")
			RETURN DIVIDE(AllCloud - Hybrid, AllCloud)
		formatString: 0.0%
		lineageTag: eabf7e39-2c2a-4c11-a2c8-489f2c4dae29

	column Date
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: 0e226af3-d189-48e7-b5e8-9b0178b1ee82
		summarizeBy: none
		sourceColumn: Date

	column Tenant
		dataType: string
		lineageTag: d99434f3-dff5-48b3-9ed5-4dc6a688ce98
		summarizeBy: none
		sourceColumn: Tenant

	column Model
		dataType: string
		lineageTag: 84f98946-a7a8-431c-b1da-43be95bfdeb6
		summarizeBy: none
		sourceColumn: Model

	column Workflow
		dataType: string
		lineageTag: 5c7fd220-33bf-43bb-886f-786efed7d677
		summarizeBy: none
		sourceColumn: Workflow

	column Policy
		dataType: string
		lineageTag: 0a357d2a-8e0b-481d-b3a4-693389dd0da9
		summarizeBy: none
		sourceColumn: Policy

	column Status
		dataType: string
		lineageTag: d7330216-eef3-4881-87a8-d9963f770875
		summarizeBy: none
		sourceColumn: Status

	column 'Policy Spend'
		dataType: double
		lineageTag: 9337c5d3-cc22-417e-9608-2e8f7100726c
		summarizeBy: none
		sourceColumn: Policy Spend

	column 'Latency ms'
		dataType: double
		lineageTag: eacf893b-360d-4196-aa13-6d2276c12e09
		summarizeBy: none
		sourceColumn: Latency ms

